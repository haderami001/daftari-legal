      "command": "export PATH=\"$HOME/development/flutter/bin:$PATH\"; flutter pub get && ./tool/preparer_web.sh",
      "options": { "cwd": "${workspaceFolder}/peche_app" },
      "problemMatcher": []
    },
    {
      "label": "Pêche Conforme : analyser et tester",
      "type": "shell",
      "command": "export PATH=\"$HOME/development/flutter/bin:$PATH\"; flutter analyze --no-fatal-infos; flutter test",
      "options": { "cwd": "${workspaceFolder}/peche_app" },
      "problemMatcher": []
    }
  ]
}
