{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pêche Conforme (démo complète, navigateur)",
      "request": "launch",
      "type": "dart",
      "cwd": "peche_app",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "args": [
        "--web-port",
        "8686",
        "--dart-define=SERVEUR_DEMO=true"
      ]
    },
    {
      "name": "Pêche Conforme (navigateur Chrome)",
      "request": "launch",
      "type": "dart",
      "cwd": "peche_app",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define=SERVEUR_DEMO=true"
      ]
    },
    {
      "name": "Pêche Conforme (téléphone / émulateur, démo complète)",
      "request": "launch",
      "type": "dart",
      "cwd": "peche_app",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=SERVEUR_DEMO=true"
      ]
    }
  ]
