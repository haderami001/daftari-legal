# Copier en « .env » (installer.sh le fait et génère les mots de passe).

# Adresses publiques : créer deux enregistrements DNS de type A vers
# l'adresse IP du serveur avant de lancer l'installation.
DOMAINE_API=api.exemple.mr
DOMAINE_AUTH=auth.exemple.mr

# Adresse e-mail pour Let's Encrypt (alertes d'expiration).
EMAIL_ACME=admin@exemple.mr

# Générés automatiquement par installer.sh s'ils sont vides.
MOT_DE_PASSE_BASE=
MOT_DE_PASSE_ADMIN_KEYCLOAK=

# Origines web autorisées à appeler l'API (CORS), séparées par des virgules.
ORIGINES_AUTORISEES=*

# « oui » : garder les comptes de démonstration (mot de passe connu de
# tous !). À n'utiliser que pour un serveur d'essai.
GARDER_COMPTES_DEMO=non

# Flotte de démonstration importée au premier démarrage (laisser vide en
# production ; ex. /app/donnees/referentiel_demo.json pour un essai).
REFERENTIEL_INITIAL=
